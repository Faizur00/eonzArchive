# EONZARCHIVE reverse proxy. Plain HTTP on port 80 because ".local" has no
# public DNS, so Let's Encrypt would fail. Requests are proxied to the
# Docker container, which publishes port 3000 on the host.
http://eonzarchive.local {
	reverse_proxy 127.0.0.1:3000

	# Request access log written to a file, in addition to Caddy's default log.
	log {
		output file /var/log/caddy/eonzarchive.access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}