# Copy to .env and fill in the values. .env is gitignored and never committed.

# Your Google Drive archive folder URL or folder ID.
ARCHIVE_FOLDER_URL = https://drive.google.com/drive/folders/1aLiI-3PnRtTB8mEfJeHuTp1f2thui--M?usp=drive_link

# The full contents of the Google service account JSON file, as a single value.
# Paste the whole file content; multi-line values are allowed.
GOOGLE_SERVICE_ACCOUNT_JSON = {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/..."}

# Any random string. Protects all /api requests.
API_TOKEN = change-me-to-a-random-string

# Your laptop's LAN IP so other devices on your network are allowed.
# Find it with: hostname -I
# Separate multiple hosts with commas. Include Docker bridge IPs if the
# server runs in a container.
ALLOWED_HOSTS = 10.28.37.165,172.17.0.1,172.18.0.1

# Keep 0.0.0.0 so Docker port mapping and other devices can reach the server.
HOST = 0.0.0.0